# ==============================================================================
# HERMES SUPER AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Mode: Hybrid (Production Full-Stack & Consumer Demo Mode)
# Architecture: Clean Architecture + Multi-Provider AI Bridge + Remotion Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="Hermes Super AI"
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://webui.5nod.com"

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# SQLite / SQLCipher (Default Embedded Engine)
DATABASE_DRIVER=sqlite
DATABASE_PATH=./database/hermes_vault.db

# PostgreSQL (Optional Production Enterprise Engine)
# DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/hermes_super_ai?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & SESSION)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_signing_key_replace_with_high_entropy_secret_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_replace_with_high_entropy_secret
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Session Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_SECRET=session_encryption_passphrase_hermes_super_ai

# ------------------------------------------------------------------------------
# 4. HERMES CORE AI & MODEL GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
# Local Hermes Core Gateway Endpoint
HERMES_API_ENDPOINT=http://127.0.0.1:8642
HERMES_API_SECRET_TOKEN=hermes_core_internal_token_secret

# AI Model Defaults
DEFAULT_CHAT_MODEL=hermes-3-llama-3.1-8b
FALLBACK_CHAT_MODEL=claude-3-5-sonnet-20241022

# External AI Provider API Keys (Optional Direct Passthrough)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=
NINEROUTE_API_KEY=

# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS & DEMO CONTROLS
# ------------------------------------------------------------------------------
# Enables 1-Click Floating Role Switcher Pill for Investor & Client Demo
ENABLE_DEMO_ROLE_SWITCHER=true

# Capabilities Toggle
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_STUDIO=true
ENABLE_VIDEO_REMOTION=true
ENABLE_VOICE_MODE=true
ENABLE_GROUNDING_CITATIONS=true

# ------------------------------------------------------------------------------
# 6. VIDEO LAB & REMOTION NATIVE RENDER ENGINE
# ------------------------------------------------------------------------------
# Executable Chromium path for server-side headless MP4 render
REMOTION_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
REMOTION_MAX_CONCURRENT_RENDERS=2
VIDEO_RENDER_TIMEOUT_MS=60000
OUTPUT_MEDIA_DIR=./storage/media

# ------------------------------------------------------------------------------
# 7. VOICE MODE & DUAL-SPEAKER TTS AUDIO SYNTHESIS
# ------------------------------------------------------------------------------
# Default voices for Remotion dual-speaker storytelling
TTS_DEFAULT_VOICE_MALE=echo
TTS_DEFAULT_VOICE_FEMALE=shimmer

# Voice Activity Detection (VAD) Silence Threshold (Milliseconds)
VAD_SILENCE_TIMEOUT_MS=750

# ------------------------------------------------------------------------------
# 8. MOBILE CLIENT & STAGING SIMULATOR PREVIEW
# ------------------------------------------------------------------------------
VITE_APP_TITLE="Hermes Super AI"
VITE_THEME_DEFAULT=graphite-frost
VITE_STAGING_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
